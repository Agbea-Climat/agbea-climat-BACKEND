# Copier en .env (jamais versionné).

# ── API (backend/) ──
DATA_DIR=data
CORS_ORIGINS=http://localhost:5173,https://agbea-climat.vercel.app

# PostgreSQL + pgvector (docker compose up -d db). Changer le mot de passe hors dev.
# POSTGRES_PORT = port publié sur l'hôte ; dans Docker, l'API joint db:5432 (docker-compose.yml).
POSTGRES_USER=agbea
POSTGRES_PASSWORD=agbea
POSTGRES_DB=agbea
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# Optionnel : URL complète (prod, base hébergée). Prioritaire sur les POSTGRES_* ci-dessus.
DATABASE_URL=

LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_API_KEY=
EMBEDDING_MODEL=
# Doit correspondre à la dimension des vecteurs produits par EMBEDDING_MODEL
EMBEDDING_DIM=1024

# ── Pipeline de données (pipeline/) — voir docs/data/acces-donnees.md ──
# Jeton NASA Earthdata : https://urs.earthdata.nasa.gov → Generate Token (valable 60 jours).
# Requis pour la pluie IMERG et pour combler les trous MODIS depuis LP DAAC.
EARTHDATA_TOKEN=
# ou bien identifiants (le jeton est préférable)
# EARTHDATA_USERNAME=
# EARTHDATA_PASSWORD=
# Téléchargements parallèles (8 par défaut ; 16 fonctionne bien pour MODIS)
AGBEA_MAX_WORKERS=8

# ── Docker (ports exposés sur l'hôte) ──
AGBEA_API_PORT=8000
AGBEA_FRONT_TEST_PORT=8089
AGBEA_DATA_PORT=8088
