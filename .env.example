DATA_DIR=data
CORS_ORIGINS=http://localhost:5173,https://agbea-climat.vercel.app

# PostgreSQL + pgvector (docker compose up -d db). Changer le mot de passe hors dev.
POSTGRES_USER=agbea
POSTGRES_PASSWORD=agbea
POSTGRES_DB=agbea
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# Optionnel : URL complète (prod, base hébergée). Prioritaire sur les POSTGRES_* ci-dessus.
DATABASE_URL=

LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_API_KEY=
EMBEDDING_MODEL=
# Doit correspondre à la dimension des vecteurs produits par EMBEDDING_MODEL
EMBEDDING_DIM=1024
