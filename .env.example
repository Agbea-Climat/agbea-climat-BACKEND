# Copier en .env (jamais versionné).

# ── API (backend/) ──
DATA_DIR=data
CORS_ORIGINS=http://localhost:5173,https://agbea-climat.vercel.app

# PostgreSQL + pgvector (docker compose up -d db). Changer le mot de passe hors dev.
# POSTGRES_PORT = port publié sur l'hôte ; dans Docker, l'API joint db:5432 (docker-compose.yml).
POSTGRES_USER=agbea
POSTGRES_PASSWORD=agbea
POSTGRES_DB=agbea
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# Optionnel : URL complète (prod, base hébergée). Prioritaire sur les POSTGRES_* ci-dessus.
DATABASE_URL=

# Assistant IA. Sans LLM_API_KEY, l'assistant répond par gabarits à partir des données calculées.
# Fournisseur : openrouter (clé sk-or-… sur https://openrouter.ai/keys) ou anthropic.
LLM_PROVIDER=openrouter
# Vide = modèle par défaut : anthropic/claude-opus-5.5 (openrouter) ou claude-opus-5-5 (anthropic).
# Ids OpenRouter : https://openrouter.ai/models (ex. anthropic/claude-sonnet-5.5).
LLM_MODEL=
LLM_API_KEY=
# Vide = https://openrouter.ai/api/v1 (openrouter) ou l'API Anthropic
LLM_BASE_URL=
# Facultatif : en-têtes HTTP-Referer / X-Title envoyés à OpenRouter (vides = non envoyés)
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=
# Vide = hash-v1 (embedder local, sans clé). Changer de modèle impose de réingérer le corpus.
EMBEDDING_MODEL=
# Doit correspondre à la dimension des vecteurs produits par EMBEDDING_MODEL
EMBEDDING_DIM=1024

# ── Pipeline de données (pipeline/) — voir docs/data/acces-donnees.md ──
# Jeton NASA Earthdata : https://urs.earthdata.nasa.gov → Generate Token (valable 60 jours).
# Requis pour la pluie IMERG et pour combler les trous MODIS depuis LP DAAC.
EARTHDATA_TOKEN=
# ou bien identifiants (le jeton est préférable)
# EARTHDATA_USERNAME=
# EARTHDATA_PASSWORD=
# Téléchargements parallèles (8 par défaut ; 16 fonctionne bien pour MODIS)
AGBEA_MAX_WORKERS=8

# ── Docker (ports exposés sur l'hôte) ──
AGBEA_API_PORT=8000
AGBEA_NOTEBOOKS_PORT=8888
AGBEA_DATA_PORT=8088
